@model IEnumerable<AuctionApp.Models.Admin.UserVm> 
<!-- Använd fullständig namespace här om det behövs, t.ex. AuctionApp.Areas.Identity.Data.AppIdentityUser -->

@{
    ViewData["Title"] = "Admin Dashboard";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4">
    <h2>Admin Dashboard - User Management</h2>
</div>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Email)</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td class="align-middle">@Html.DisplayFor(modelItem => user.Email)</td>
            <td>
                <div class="d-flex align-items-center">
                    <!-- Länken för att se auktionerna -->
                    @Html.ActionLink("Show Auctions", "UserAuctions", new { email = user.Email }, new { @class = "btn btn-sm btn-primary me-2" })
        
                    <!-- Formuläret för att radera användaren -->
                    <form asp-action="DeleteUser" asp-controller="Admin" method="post" onsubmit="return confirm('Are you sure you want to delete this user? ALL their auctions and bids will be permanently lost!');">
                        <input type="hidden" name="email" value="@user.Email" />
            
                        <!-- Om användaren är inloggad inaktiverar vi raderingsknappen visuellt -->
                        <button type="submit" class="btn btn-sm btn-danger" @(user.Email == User.Identity.Name ? "disabled" : "")>Delete User</button>
                    </form>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>