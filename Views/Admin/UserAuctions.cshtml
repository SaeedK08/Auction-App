@model IEnumerable<AuctionApp.Models.Auctions.AuctionVm>

@{
    ViewData["Title"] = "User Auctions";
}

@if (TempData["DeleteSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["DeleteSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["DeleteError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["DeleteError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Auctions created by: @ViewBag.UserEmail</h2>
    @Html.ActionLink("Back to Users", "Index", "Admin", null, new { @class = "btn btn-secondary" })
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        This user has not created any auctions yet.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.StartingPrice)</th>
            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.Title)</td>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.StartingPrice)</td>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.EndDate)</td>
                <td>
                    <div class="d-flex align-items-center">
                        @Html.ActionLink("Details", "Details", "Auctions", new { id = item.Id }, new { @class = "btn btn-sm btn-info text-white me-2" })
        
                        <!-- Formulär för att skicka en säker POST-request för radering -->
                        <form asp-action="DeleteAuction" asp-controller="Admin" method="post" onsubmit="return confirm('Are you sure you want to delete this auction? All related bids will also be removed.');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="ownerEmail" value="@ViewBag.UserEmail" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}