@model AuctionApp.Models.Auctions.CreateAuctionVm

@{
    ViewData["Title"] = "Create Auction";
}

<h2>Create New Auction</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("Create", "Auctions", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <!-- Displays Domain/Database exceptions caught in the Controller -->
            @Html.ValidationSummary(true, "", new { @class = "text-danger fw-bold mb-3" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Title, new { @class = "control-label fw-bold" })
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Description, new { @class = "control-label fw-bold" })
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>
            

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.StartingPrice, new { @class = "control-label fw-bold" })
                @Html.TextBoxFor(m => m.StartingPrice, new { @class = "form-control", type = "number", step = "0.01" })
                @Html.ValidationMessageFor(m => m.StartingPrice, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.EndDate, new { @class = "control-label fw-bold" })
                @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control", type = "datetime-local" })
                @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-success" />
                @Html.ActionLink("Cancel", "Index", "Auctions", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        }
    </div>
</div>