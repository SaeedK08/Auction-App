@model AuctionApp.Models.Auctions.AuctionDetailsVm

@{
    ViewData["Title"] = "Auction Details";
}

<!-- ALERTS FOR SUCCESS OR VALIDATION ERRORS -->

<!-- ALERTS FOR BIDS -->
@if (TempData["BidSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["BidSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["BidError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["BidError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- AUCTION DETAILS -->
<h2>@Html.DisplayFor(m => m.Title)</h2>
<hr />

<dl class="row mb-0">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.OwnerName)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.OwnerName)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.StartingPrice)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.StartingPrice)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EndDate)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.EndDate)</dd>
</dl>

<div class="mt-3">
    @Html.ActionLink(
        "Back to List",
        "Index",
        "Auctions",
        null,
        new { @class = "btn btn-secondary" }
    )
</div>


<!-- BIDDING SECTION -->
@if (Model.CanBid)
{
    <form asp-action="PlaceBid" asp-controller="Auctions" method="post" class="mt-4 mb-4">
        @Html.AntiForgeryToken()
        
        <!-- Bind to the ViewModel properties -->
        <input type="hidden" name="AuctionId" value="@Model.NewBid.AuctionId" />
        
        <div class="input-group" style="max-width: 300px;">
            <input name="Amount" type="number" min="1" step="1" class="form-control" placeholder="Your bid" required />
            <button type="submit" class="btn btn-success">Place bid</button>
        </div>
    </form>
}
else if (Model.HasEnded)
{
    <div class="alert alert-secondary mt-4 mb-4">
        <strong>Auction Finished:</strong> This auction ended on @Model.EndDate.ToString("yyyy-MM-dd HH:mm") and no further bids can be placed.
    </div>
}
else
{
    <div class="alert alert-info mt-4 mb-4">
        You are the owner of this auction. You cannot bid on your own items.
    </div>
}

<!-- BIDS TABLE -->
<h3 class="mt-5">@Html.DisplayNameFor(m => m.BidVms)</h3>
<hr />

@if (!Model.BidVms.Any() && Model.CanBid)
{
    <div class="alert alert-info">
        There are no bids on this auction yet. Be the first to place one!
    </div>
}
else
{
    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(m => m.BidVms.First().BidderName)
                </th>
                <th>
                    @Html.DisplayNameFor(m => m.BidVms.First().Amount)
                </th>
                <th>
                    @Html.DisplayNameFor(m => m.BidVms.First().TimePlaced)
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var bid in Model.BidVms)
            {
                <tr>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => bid.BidderName)
                    </td>

                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => bid.Amount)
                    </td>

                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => bid.TimePlaced)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
