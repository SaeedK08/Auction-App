@model AuctionApp.Models.Auctions.EditAuctionVm

@{
    ViewData["Title"] = "Edit Auction";
}

@if (TempData["EditSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["EditSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["EditError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["EditError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Title is displayed as a pure header, totally uneditable -->
<h2>Edit Description for: @Html.DisplayFor(m => m.Title)</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm("Edit", "Auctions", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            
            <!-- Generates <input type="hidden"> because of [HiddenInput] -->
            @Html.EditorFor(m => m.Id)
            
            <!-- Keeps the title alive if the form fails validation and reloads -->
            @Html.HiddenFor(m => m.Title)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Description, new { @class = "control-label fw-bold mb-2" })
                <!-- Generates <textarea> because of [DataType(DataType.MultilineText)] -->
                @Html.EditorFor(m => m.Description, new { htmlAttributes = new { @class = "form-control", rows = 5 } })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Save Changes" class="btn btn-success" />
                @Html.ActionLink("Cancel", "Index", "Auctions", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        }
    </div>
</div>