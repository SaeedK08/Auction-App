@model IEnumerable<AuctionApp.Models.Auctions.AuctionVm>

@{
    ViewData["Title"] = "My Bids";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Auctions I'm Bidding On</h2>
    @Html.ActionLink("Back to Active Auctions", "Index", "Auctions", null, new { @class = "btn btn-secondary" })
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't placed any bids on active auctions yet.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.OwnerName)</th>
            <th>@Html.DisplayNameFor(model => model.StartingPrice)</th>
            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.Title)</td>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.OwnerName)</td>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.StartingPrice)</td>
                <td class="align-middle">@Html.DisplayFor(modelItem => item.EndDate)</td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info text-white" })
                </td>
            </tr>
        }
        </tbody>
    </table>
}